#!/usr/bin/env bash
# dispatch-verify：执行验证命令，完整日志写入文件，只回显摘要。
# 用来代替"验证子 agent"：构建和测试的长输出不进入上下文，也不消耗模型额度。
#
# 用法：dispatch-verify <命令...>
#   dispatch-verify npm test
#   dispatch-verify "make lint && make test"
# 环境变量：
#   DISPATCH_VERIFY_TAIL   失败时回显末尾多少行（默认 40；通过时固定只回显 8 行）
#   DISPATCH_VERIFY_ERRORS 最多回显多少条报错行（默认 30）

if [ "$#" -eq 0 ]; then
  echo "用法：dispatch-verify <命令...>" >&2
  exit 2
fi

tail_n="${DISPATCH_VERIFY_TAIL:-40}"
err_n="${DISPATCH_VERIFY_ERRORS:-30}"
tmp="${TMPDIR:-/tmp}"
log_dir="${tmp%/}/dispatch-verify"
mkdir -p "$log_dir"
log="$log_dir/$(date '+%Y%m%d-%H%M%S')-$$.log"

start=$(date +%s)
bash -c "$*" >"$log" 2>&1
code=$?
secs=$(( $(date +%s) - start ))
lines=$(wc -l <"$log" | tr -d ' ')

if [ "$code" -eq 0 ]; then
  echo "✔ 通过 · 退出码 0 · ${secs}s · 日志 ${lines} 行"
  tail_n=8
else
  echo "✘ 失败 · 退出码 ${code} · ${secs}s · 日志 ${lines} 行"
  errors="$(grep -nE -i '(^|[^a-z])(error|failed|failure|exception|panic|fatal|undefined|cannot find|not found)([^a-z]|$)' "$log" | head -n "$err_n")"
  if [ -n "$errors" ]; then
    echo "── 报错行（最多 ${err_n} 条，前缀为日志行号）──"
    printf '%s\n' "$errors" | cut -c1-300
  fi
fi

if [ "$lines" -gt 0 ]; then
  echo "── 末尾 ${tail_n} 行 ──"
  tail -n "$tail_n" "$log" | cut -c1-300
fi
echo "完整日志：$log"
exit "$code"

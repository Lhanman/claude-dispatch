"""

INDEX_JS = """
const q=document.getElementById('q'),items=[...document.querySelectorAll('.item')],empty=document.getElementById('empty'),count=document.getElementById('count');
let kind='',tags=new Set();
function apply(){const s=q.value.trim().toLowerCase();let n=0;
for(const el of items){const ok=(!s||el.dataset.text.includes(s))&&(!kind||el.dataset.kind===kind)&&[...tags].every(t=>el.dataset.tags.split('|').includes(t));
el.hidden=!ok;if(ok&&el.dataset.view==='time')n++}
for(const g of document.querySelectorAll('.group'))g.hidden=![...g.querySelectorAll('.item')].some(x=>!x.hidden);
count.textContent=n;empty.hidden=n>0}
q.addEventListener('input',apply);
for(const b of document.querySelectorAll('button.kind'))b.addEventListener('click',()=>{
const v=b.dataset.kind;kind=kind===v?'':v;
for(const o of document.querySelectorAll('button.kind'))o.setAttribute('aria-pressed',o.dataset.kind===kind);apply()});
for(const b of document.querySelectorAll('button.tag'))b.addEventListener('click',()=>{
const t=b.dataset.tag;tags.has(t)?tags.delete(t):tags.add(t);b.setAttribute('aria-pressed',tags.has(t));apply()});
for(const b of document.querySelectorAll('button.view'))b.addEventListener('click',()=>{
const v=b.dataset.view;
for(const o of document.querySelectorAll('button.view'))o.setAttribute('aria-pressed',o.dataset.view===v);
document.getElementById('by-time').hidden=v!=='time';document.getElementById('by-project').hidden=v!=='project';apply()});
"""


def hub_items(repo, cat):
    """首页的条目：HTML 文档和知识库笔记合在一起，按更新时间倒序。"""
    items = []
    for p in cat["pages"]:
        items.append({
            "kind": "文档", "url": f'p/{quote(p["slug"])}/', "title": p["title"],
            "desc": p.get("description", ""), "type": "", "project": p.get("project", ""),
            "tags": p.get("tags", []), "updated": p.get("updated", ""),
            "text": " ".join([p["title"], p.get("description", ""), p.get("project", ""),
                              " ".join(p.get("tags", [])), p["slug"]]),
        })
    for n in kbsite.load_kb(repo):
        items.append({
            "kind": "笔记", "url": f'kb/{quote(n["slug"])}/', "title": n["title"],
            "desc": n.get("summary", ""), "type": n.get("type", ""), "project": n.get("project", ""),
            "tags": n.get("tags", []), "updated": n.get("updated", ""),
            "text": " ".join([n["title"], n.get("summary", ""), n.get("project", ""), n.get("type", ""),
                              " ".join(n.get("tags", [])), n.get("text", "")]),
        })
    items.sort(key=lambda x: (x["updated"], x["title"]), reverse=True)
    return items


def item_html(it, view):
    e = html.escape
    meta = [f'<span class="kind">{e(it["kind"])}</span>']
    if it.get("type"):
        meta.append(f'<span class="chip">{e(it["type"])}</span>')
    if it.get("project"):
        meta.append(f'<span>{e(it["project"])}</span>')
    meta.append(f'<span>{e(it["updated"])}</span>')
    meta += [f'<span class="chip">{e(t)}</span>' for t in it["tags"]]
    return (
        f'<li class="item" data-view="{view}" data-kind="{e(it["kind"])}" '
        f'data-tags="{e("|".join(it["tags"]))}" data-text="{e(it["text"].lower())}">'
        f'<a class="t" href="{it["url"]}">{e(it["title"])}</a>'
        + (f'<p>{e(it["desc"])}</p>' if it.get("desc") else "")
        + f'<div class="meta">{"".join(meta)}</div></li>'
    )


def build_index(repo, cat):
    title = CFG.get("pages_title", "文档")
    pages = cat["pages"]
    notes = kbsite.load_kb(repo)
    items = hub_items(repo, cat)
    e = html.escape
    all_tags = sorted({t for it in items for t in it["tags"]},
                      key=lambda t: (-sum(t in it["tags"] for it in items), t))[:24]
    by_time = "".join(item_html(it, "time") for it in items)
    groups = {}
    for it in items:
        groups.setdefault(it["project"] or CFG.get("pages_misc", "其他"), []).append(it)
    by_project = "".join(
        f'<section class="group"><h2>{e(name)}</h2><ol class="items">'
        + "".join(item_html(it, "project") for it in groups[name]) + "</ol></section>"
        for name in sorted(groups, key=lambda g: (-len(groups[g]), g))
    )
    tag_buttons = "".join(
        f'<button class="pill tag" type="button" data-tag="{e(t)}" aria-pressed="false">{e(t)}</button>'
        for t in all_tags)
    latest = items[0]["updated"] if items else ""
    counts = f"{len(notes)} 篇笔记 · {len(pages)} 篇文档" if notes else f"{len(pages)} 篇文档"
    graph_card = (
        '<div class="graph-card"><a href="graph/">知识图谱 →</a>'
        f'<span>{len(notes)} 篇笔记之间的链接和共同标签</span></div>' if notes else "")
    doc = f"""<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{e(title)}</title>
<meta name="description" content="{e(title)}：{e(counts)}">
{kbsite.FONTS}
<style>{INDEX_CSS}</style>
</head>
<body>
<main>
<header class="site">
<span class="eyebrow">知识库中心 · {e(counts)}</span>
<h1>{e(title)}</h1>
<p class="lede">和 Claude Code 一起写下的方案、手册和调研，以及从个人知识库同步来的笔记。</p>
<div class="ramp" aria-hidden="true"><i style="background:#8E97AA"></i><i style="background:#6680B3"></i><i style="background:#4865AA"></i><i style="background:#2E4893"></i><i style="background:#1B2D6A"></i></div>
</header>
<div class="controls">
<input id="q" type="search" placeholder="搜索标题、摘要、标签和正文" aria-label="搜索">
<div class="row">
<button class="pill kind" type="button" data-kind="笔记" aria-pressed="false">笔记</button>
<button class="pill kind" type="button" data-kind="文档" aria-pressed="false">文档</button>
<span class="sep"></span>
<button class="pill view" type="button" data-view="time" aria-pressed="true">按时间</button>
<button class="pill view" type="button" data-view="project" aria-pressed="false">按项目</button>
</div>
<div class="row">{tag_buttons}</div>
<p class="hint"><span id="count">{len(items)}</span> 条</p>
</div>
<ol class="items" id="by-time">{by_time}</ol>
<div id="by-project" hidden>{by_project}</div>
<p class="empty" id="empty" hidden>没有匹配的内容。</p>
{graph_card}
<footer>最近更新 {e(latest)}</footer>
</main>
<script>{INDEX_JS}</script>
</body>
</html>
"""
    with open(os.path.join(repo, "index.html"), "w", encoding="utf-8") as f:
        f.write(doc)
    nojekyll = os.path.join(repo, ".nojekyll")
    if not os.path.exists(nojekyll):
        open(nojekyll, "w").close()
    gitignore = os.path.join(repo, ".gitignore")
    ignored = open(gitignore).read().split() if os.path.exists(gitignore) else []
    missing = [x for x in (".DS_Store", "_site/") if x not in ignored]
    if missing:
        with open(gitignore, "a") as f:
            f.write("".join(x + "\n" for x in missing))
    write_deploy_files(repo)
    build_readme(repo, pages, notes, title)


# 部署：仓库里存中文路径，上线时按 catalog.json 复制成英文网址 p/<slug>/。
BUILD_SCRIPT = '''#!/usr/bin/env python3
"""由 dispatch-pages 生成，不要手改。

仓库里的页面按中文路径存放（文档/<项目>/<标题>.html、知识库/<目录>/<笔记>.html），
线上网址用英文：按 catalog.json 和 kb.json 复制成 p/<slug>/、kb/<slug>/，
再放上目录页 index.html 和图谱页 graph/index.html。
用法：python3 .github/build-site.py <输出目录>
"""
import json
import os
import re
import shutil
import sys

root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
out = os.path.abspath(sys.argv[1] if len(sys.argv) > 1 else "_site")
shutil.rmtree(out, ignore_errors=True)
os.makedirs(out)


def load(name, key):
    try:
        with open(os.path.join(root, name), encoding="utf-8") as f:
            return json.load(f)[key]
    except (OSError, ValueError, KeyError):
        return []


def copy(rel, parts, index_href):
    """把一个中文路径的页面复制到英文网址下；单篇出错只跳过这一篇，不拖垮整站部署。"""
    try:
        with open(os.path.join(root, rel), encoding="utf-8") as f:
            text = f.read()
    except OSError as err:
        print(f"跳过 {'/'.join(parts)}：读不到 {rel}（{err.strerror}）", file=sys.stderr)
        return 0
    text = re.sub(r'<link rel="index" href="[^"]*">', f'<link rel="index" href="{index_href}">', text, count=1)
    dst = os.path.join(out, *parts)
    os.makedirs(dst, exist_ok=True)
    with open(os.path.join(dst, "index.html"), "w", encoding="utf-8") as f:
        f.write(text)
    return 1


pages = load("catalog.json", "pages")
notes = load("kb.json", "notes")
done = sum(copy(p.get("path") or f"p/{p['slug']}/index.html", ("p", p["slug"]), "../../index.html") for p in pages)
done += sum(copy(n["path"], ("kb", n["slug"]), "../../index.html") for n in notes)
if notes and os.path.exists(os.path.join(root, "知识图谱.html")):
    done += copy("知识图谱.html", ("graph",), "../index.html")
shutil.copy(os.path.join(root, "index.html"), os.path.join(out, "index.html"))
print(f"已生成 {done} 个页面（文档 {len(pages)} · 笔记 {len(notes)}）→ {out}")
'''

WORKFLOW = """# 由 dispatch-pages 生成，不要手改。
# 仓库里的文档用中文路径存放，部署时按 catalog.json 复制成英文网址 p/<slug>/ 再上线。
# 需要在仓库 Settings → Pages → Source 选 GitHub Actions。
name: 部署文档站
on:
  push:
    branches: [main, master]
  workflow_dispatch:
permissions:
  contents: read
  pages: write
  id-token: write
concurrency:
  group: pages
  cancel-in-progress: true
jobs:
  deploy:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - uses: actions/checkout@v7
      - run: python3 .github/build-site.py _site
      - uses: actions/upload-pages-artifact@v5
        with:
          path: _site
      - id: deployment
        uses: actions/deploy-pages@v5
"""


def write_deploy_files(repo):
    for rel, text in ((".github/build-site.py", BUILD_SCRIPT), (".github/workflows/pages.yml", WORKFLOW)):
        path = os.path.join(repo, rel)
        if os.path.exists(path):
            with open(path, encoding="utf-8") as f:
                if f.read() == text:
                    continue
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            f.write(text)


def build_readme(repo, pages, notes, title):
    """仓库首页的 README：说明目录结构，按项目列出全部文档，再列出同步来的笔记。"""
    root, misc = docs_root(), CFG.get("pages_misc", "其他")
    url = site_url()
    lines = [f"# {title}", "",
             "和 Claude Code 一起写下的方案、手册和调研，以及从个人知识库同步来的笔记，自动发布"
             + (f"在 {url}/ 。" if url else "。"), "",
             "## 目录结构", "",
             f"- `{root}/<项目>/<标题>.html`：每篇文档，按项目分目录，文件名就是标题；不属于任何项目的放在 `{root}/{misc}/`。",
             f"- `{kbsite.KB_DIR_NAME}/<目录>/<笔记>.html`：从知识库同步来的笔记，目录结构和知识库一致。",
             "- `index.html`：网站首页，可以搜索、按标签和类别筛选。",
             f"- `{kbsite.GRAPH_FILE}`：知识图谱页，线上在 `graph/`。",
             "- `catalog.json`、`kb.json`：文档和笔记的清单数据。",
             "- `.github/`：部署流程。上线时按清单把页面复制到英文网址 `p/<slug>/`、`kb/<slug>/`，线上不出现中文路径。",
             "", "这些文件全部由 `dispatch-pages` 自动生成，不要手动修改；笔记的正文请在知识库里改，"
             "下一次同步会覆盖这里的副本。", "",
             f"## 文档清单（{len(pages)} 篇）"]
    groups = {}
    for p in pages:
        groups.setdefault(p.get("project") or misc, []).append(p)
    for name in sorted(groups, key=lambda g: (g == misc, g)):
        lines += ["", f"### {name}", ""]
        for p in groups[name]:
            desc = f" — {p['description']}" if p.get("description") else ""
            lines.append(f"- [{p['title']}]({quote(p['path'])}) · [线上]({page_url(p['slug'])}) · {p.get('updated', '')}{desc}")
    if notes:
        lines += ["", f"## 知识库笔记（{len(notes)} 篇）"]
        note_groups = {}
        for n in notes:
            note_groups.setdefault(n.get("project") or misc, []).append(n)
        for name in sorted(note_groups, key=lambda g: (g == misc, g)):
            lines += ["", f"### {name}", ""]
            for n in note_groups[name]:
                desc = f" — {n['summary']}" if n.get("summary") else ""
                online = f"{site_url()}/kb/{n['slug']}/" if site_url() else f"kb/{n['slug']}/"
                lines.append(f"- [{n['title']}]({quote(n['path'])}) · [线上]({online}) · {n.get('updated', '')}{desc}")
    with open(os.path.join(repo, "README.md"), "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")


# ---------- git ----------

def git(repo, *args):
    return subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)


def unpushed(repo):
    """本地有提交还没推上去（上次推送失败时会这样）。没有上游分支时按「有」处理，交给 push 去判断。"""
    r = git(repo, "rev-list", "--count", "@{u}..HEAD")
    if r.returncode != 0:
        return bool(git(repo, "log", "-1", "--oneline").stdout.strip())
    return r.stdout.strip() not in ("", "0")


def push_head(repo):
    if not git(repo, "remote").stdout.strip():
        fail("已提交到本地，但仓库没有配置远程地址，未推送。", 4)
    r = git(repo, "push", "-u", "origin", "HEAD")
    if r.returncode != 0:
        fail("已提交到本地，推送失败：" + (r.stderr or r.stdout).strip()[-400:], 4)


def commit_and_push(repo, message, push):
    git(repo, "add", "-A")
    if git(repo, "diff", "--cached", "--quiet").returncode == 0:
        if push and unpushed(repo):
            print("没有新变化，但有未推送的提交，补推一次。")
            push_head(repo)
            return
        print("没有变化，无需提交。")
        return
    r = git(repo, "commit", "-m", message)
    if r.returncode != 0:
        fail("提交失败：" + (r.stderr or r.stdout).strip()[-400:])
    if not push:
        print("已提交到本地（--no-push，未推送）。")
        return
    push_head(repo)


# ---------- 子命令 ----------

def cmd_check(args):
    allow = split_list(take_opt(args, "--allow"))
    if not args:
        fail("用法：dispatch-pages check <文件> [--allow 词,词]")
    with open(args[0], encoding="utf-8") as f:
        text = f.read()
    blocks, warns = scan(text, allow)
    report(blocks, warns)
    if blocks:
        fail("✘ 检查未通过，不能发布。", 3)
    print("✔ 检查通过" + ("（有提醒，见上）" if warns else ""))


def cmd_publish(args):
    slug = take_opt(args, "--slug")
    desc = take_opt(args, "--desc")
    tags = take_opt(args, "--tags")
    project = take_opt(args, "--project")
    allow = split_list(take_opt(args, "--allow"))
    push = not take_flag(args, "--no-push")
    if not args:
        fail("用法：dispatch-pages publish <文件> [--slug 名称] [--desc 一句话] [--tags a,b] [--project 名称] [--allow 词,词] [--no-push]")
    src_path = args[0]
    with open(src_path, encoding="utf-8") as f:
        src = f.read()
    slug = slug or os.path.splitext(os.path.basename(src_path))[0]
    slug = re.sub(r"[^a-z0-9-]+", "-", slug.lower()).strip("-")
    if not slug:
        fail("无法从文件名得到英文 slug，请用 --slug 指定，例如 --slug dispatch-manual")

    blocks, warns = scan(src, allow)
    report(blocks, warns)
    if blocks:
        fail("✘ 检查未通过，未发布。改掉命中的内容，或确认无妨后用 --allow 放行。", 3)

    repo = repo_dir()
    cat = load_catalog(repo)
    old = next((p for p in cat["pages"] if p["slug"] == slug), None)
    today = date.today().isoformat()
    entry = {
        "slug": slug,
        "title": page_title(src, slug),
        "description": desc if desc is not None else (page_desc(src) or (old or {}).get("description", "")),
        "tags": split_list(tags) if tags is not None else (old or {}).get("tags", []),
        "project": project if project is not None else (old or {}).get("project", ""),
        "created": (old or {}).get("created", today),
        "updated": today,
    }
    others = [p for p in cat["pages"] if p["slug"] != slug]
    rel = target_path(entry, others)
    old_rel = ((old or {}).get("path") or legacy_path(slug)) if old else None
    dst = os.path.join(repo, rel)
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    with open(dst, "w", encoding="utf-8") as f:
        f.write(wrap(src, entry["description"], rel))
    if old_rel and old_rel != rel and os.path.exists(os.path.join(repo, old_rel)):
        os.remove(os.path.join(repo, old_rel))
        prune_empty(repo, old_rel)
    entry["path"] = rel
    cat["pages"] = others + [entry]
    save_catalog(repo, cat)
    build_index(repo, cat)
    commit_and_push(repo, f"{'更新' if old else '发布'}：{entry['title']}", push)
    print(f"✔ {'已更新' if old else '已发布'}：{entry['title']}\n  文件：{rel}\n  网址：{page_url(slug)}\n  目录：{site_url() or repo}/")


def row(p):
    d = p.get("description", "")
    d = d[:60] + "…" if len(d) > 60 else d
    return f"{p['slug']} │ {p.get('updated', '')} │ {p.get('path') or p['title']} │ {d}"


def cmd_list(args):
    limit = int(take_opt(args, "-n", "20"))
    pages = load_catalog(repo_dir())["pages"]
    for p in pages[:limit]:
        print(row(p))
    if len(pages) > limit:
        print(f"……共 {len(pages)} 篇，只列出前 {limit} 篇（用 -n 调整）")
    if not pages:
        print("还没有发布任何文档。")


def cmd_search(args):
    limit = int(take_opt(args, "-n", "10"))
    terms = [t.lower() for t in args if t.strip()]
    if not terms:
        fail("用法：dispatch-pages search <词>... [-n 条数]")
    hits = []
    for p in load_catalog(repo_dir())["pages"]:
        text = " ".join([p["slug"], p["title"], p.get("description", ""), p.get("project", ""), " ".join(p.get("tags", []))]).lower()
        n = sum(t in text for t in terms)
        if n:
            hits.append((-n, p))
    hits.sort(key=lambda x: x[0])
    if not hits:
        print("没有找到相关文档。")
    for _, p in hits[:limit]:
        print(row(p))


def cmd_remove(args):
    push = not take_flag(args, "--no-push")
    if not args:
        fail("用法：dispatch-pages remove <slug>")
    repo, slug = repo_dir(), args[0]
    cat = load_catalog(repo)
    old = next((p for p in cat["pages"] if p["slug"] == slug), None)
    if not old:
        fail(f"没有这篇文档：{slug}")
    cat["pages"] = [p for p in cat["pages"] if p["slug"] != slug]
    rel = old.get("path") or legacy_path(slug)
    if os.path.exists(os.path.join(repo, rel)):
        os.remove(os.path.join(repo, rel))
        prune_empty(repo, rel)
    save_catalog(repo, cat)
    build_index(repo, cat)
    commit_and_push(repo, f"下线：{old['title']}", push)
    print(f"✔ 已下线：{old['title']}")


def cmd_rebuild(args):
    push = not take_flag(args, "--no-push")
    repo = repo_dir()
    cat = load_catalog(repo)
    moved = []
    for p in cat["pages"]:
        before = p.get("path") or legacy_path(p["slug"])
        if place(repo, p, [q for q in cat["pages"] if q is not p]) != before:
            moved.append(f"  {before} → {p['path']}")
    save_catalog(repo, cat)
    notes = kbsite.rebuild_graph(repo, CFG.get("pages_title", "文档"))
    build_index(repo, cat)
    commit_and_push(repo, "整理目录结构" if moved else "重建目录页", push)
    print(f"✔ 首页已重建（文档 {len(cat['pages'])} 篇 · 笔记 {notes} 篇）"
          + (f"，移动了 {len(moved)} 篇：\n" + "\n".join(moved) if moved else ""))


def kb_dir():
    d = CFG.get("kb_dir")
    if not d:
        fail("未配置知识库：在 ~/.claude/dispatch/config 写入 kb_dir=<目录>。")
    d = os.path.expanduser(d).rstrip("/")
    if not os.path.isdir(d):
        fail(f"知识库目录不存在：{d}")
    return d


def report_kb(res, public_dirs):
    print(f"白名单：{'、'.join(public_dirs)}（白名单外的目录不参与，也没有放行开关）")
    if res.blocked:
        print(f"── 未上传：敏感检查未通过（{len(res.blocked)} 篇）──")
        for src, why, hits in res.blocked:
            print(f"  {src} │ {why}")
            for h in hits:
                print(f"      {h[:180]}")
    if res.opted_out:
        print(f"── 未上传：笔记里写了 publish: false（{len(res.opted_out)} 篇）──")
        for src in res.opted_out:
            print(f"  {src}")
    if res.no_images:
        print(f"── 提醒：本地图片没有上传，页面上显示「（图片未公开）」（{len(res.no_images)} 篇）──")
        for src in res.no_images:
            print(f"  {src}")
    if res.warnings:
        print(f"── 提醒：内容里有这些字样，自行判断（{len(res.warnings)} 篇）──")
        for src, hits in res.warnings:
            print(f"  {src} │ " + " ； ".join(h.split("│")[1].strip() + "→" + h.split("│")[2].strip()
                                              for h in hits if h.count("│") >= 2)[:200])


def cmd_kb_sync(args):
    dry = take_flag(args, "--dry-run")
    push = not take_flag(args, "--no-push")
    public_dirs = split_list(CFG.get("kb_public"))
    if not public_dirs:
        fail("没有配置公开白名单：在 ~/.claude/dispatch/config 写入 kb_public=<顶层目录,逗号分隔>，"
             "例如 kb_public=个人项目,技术笔记。没有这一行时不会同步任何笔记。")
    kb, repo = kb_dir(), repo_dir()
    res = kbsite.sync(kb, repo, CFG, scan, dry_run=dry)
    report_kb(res, public_dirs)
    if dry:
        print(f"（--dry-run，没有写入）会同步 {len(res.published)} 篇笔记：")
        for n in res.published[:30]:
            print(f"  {n.src} → {page_kb_url(n.slug)}")
        return
    cat = load_catalog(repo)
    build_index(repo, cat)
    changed = f"新增 {len(res.added)} · 更新 {len(res.updated)} · 下线 {len(res.removed)}"
    n = len(res.published)
    # 笔记没变、只是页面模板变了时，别把提交说成「新增 0 · 更新 0」
    quiet = not (res.added or res.updated or res.removed)
    commit_and_push(repo, f"知识库同步：重建页面（{n} 篇笔记）" if quiet else f"知识库同步：{n} 篇笔记（{changed}）", push)
    print(f"✔ 已同步 {len(res.published)} 篇笔记（{changed}）")
    for n in res.added + res.updated:
        print(f"  {n.title} → {page_kb_url(n.slug)}")
    print(f"  首页：{site_url() or repo}/    图谱：{site_url()}/graph/" if site_url() else f"  首页：{repo}")


def page_kb_url(slug):
    return f"{site_url()}/kb/{slug}/" if site_url() else f"kb/{slug}/"


def cmd_hook(_args):
    """PostToolUse(Artifact) 调用：页面发布后，提示主会话把它同步发布到文档站。没配置文档站时什么也不输出。"""
    try:
        data = json.load(sys.stdin)
    except ValueError:
        return
    ti = data.get("tool_input") or {}
    path = ti.get("file_path") or ""
    if ti.get("action") not in (None, "", "publish") or not path.lower().endswith((".html", ".htm")):
        return
    if not CFG.get("pages_repo"):
        return
    slug = re.sub(r"[^a-z0-9-]+", "-", os.path.splitext(os.path.basename(path))[0].lower()).strip("-")
    repo = os.path.expanduser(CFG["pages_repo"])
    old = None
    if slug and os.path.isdir(repo):
        old = next((p for p in load_catalog(repo)["pages"] if p["slug"] == slug), None)
    cmd = f'dispatch-pages publish "{path}" --slug {slug or "<英文短名>"}'
    if old:
        todo = f"这是已发布文档「{old['title']}」的更新：执行 `{cmd}`（摘要和标签不变就不用再传）。"
    else:
        todo = (f'执行 `{cmd} --desc "<一句话摘要>" --tags <3–5 个标签> --project <项目>`。'
                "--project 决定放进哪个目录（文档/<项目>/<标题>.html），不属于任何项目才省略。")
    msg = (f"文档站：这个 HTML 页面需要同步发布到公开站点 {site_url() or repo}，用户已授权自动发布，不用再问。{todo}"
           "回复里给出网址。退出码 3 表示敏感检查未通过：停下，把命中项给用户看，由用户决定改内容、--allow 放行还是不发。")
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PostToolUse", "additionalContext": msg}}, ensure_ascii=False))


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cmd, rest = args[0], args[1:]
    if cmd == "url":
        repo_dir()
        print(site_url())
        return
    handlers = {"check": cmd_check, "publish": cmd_publish, "list": cmd_list, "search": cmd_search,
                "remove": cmd_remove, "rebuild": cmd_rebuild, "kb-sync": cmd_kb_sync, "hook": cmd_hook}
    if cmd not in handlers:
        fail(f"未知子命令：{cmd}（可用：url、check、publish、list、search、remove、rebuild、kb-sync）")
    handlers[cmd](rest)


if __name__ == "__main__":
    main()

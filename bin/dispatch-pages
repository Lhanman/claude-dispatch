#!/usr/bin/env python3
"""dispatch-pages：把 HTML 文档发布到静态文档站（如 GitHub Pages），并维护目录页。

发布前先做敏感检查：本机绝对路径、邮箱、疑似密钥、Artifact 专属能力，以及配置的敏感词。
命中就不发布（退出码 3），把命中项列出来，由用户决定改内容、用 --allow 放行，还是不发。

用法：
  dispatch-pages url                         打印站点网址
  dispatch-pages check <文件> [--allow 词,词]  只做发布前检查
  dispatch-pages publish <文件> [--slug 名称] [--desc 一句话] [--tags a,b] [--project 名称]
                            [--allow 词,词] [--no-push]
  dispatch-pages list [-n 条数]               每篇一行：slug │ 日期 │ 标题 │ 摘要
  dispatch-pages search <词>... [-n 条数]
  dispatch-pages remove <slug> [--no-push]
  dispatch-pages rebuild [--no-push]         按 catalog.json 重新生成目录页
  dispatch-pages kb-sync [--dry-run] [--no-push]
                            把知识库里白名单内的笔记全量同步到站点（见下）

仓库结构：文档按项目分目录，文件名就是文档标题，方便在本地直接找：
  文档/<项目>/<标题>.html    不属于任何项目的放在 文档/其他/
  知识库/<目录>/<笔记>.html  从知识库同步来的笔记，目录结构和知识库一致
  index.html · README.md · catalog.json · kb.json · 知识图谱.html · .github/  自动生成，不要手改
线上网址一律用英文：文档 <站点>/p/<slug>/，笔记 <站点>/kb/<slug>/，图谱 <站点>/graph/。
部署由 .github/workflows/pages.yml 完成，按 catalog.json 和 kb.json 把中文路径的页面复制成
英文网址再上线；仓库的 Settings → Pages → Source 需要选 GitHub Actions。
slug 是每篇文档不变的英文标识（默认取源文件名），用来判断是新发布还是更新，也是网址的一部分。

知识库同步（kb-sync）：只同步 kb_public 列出的顶层目录，没配置就什么都不同步；单篇可以用
frontmatter `publish: false` 退出；笔记原文和渲染结果各过一遍敏感检查，命中就整篇跳过，
不支持 --allow；指向未公开笔记的 [[链接]] 会整体换成「（未公开）」；本地图片不上传。
每次都是全量同步：笔记改名、删除、改成不公开，下一次同步会自动下线。

配置（~/.claude/dispatch/config）：
  pages_repo=<站点仓库的本地目录>     pages_url=<站点网址>
  pages_title=<目录页标题>             pages_deny=<敏感词，逗号分隔>
  pages_docs_dir=<文档根目录，默认「文档」>  pages_misc=<无项目时的目录，默认「其他」>
  kb_dir=<知识库目录>                  kb_public=<允许公开的顶层目录，逗号分隔>
  kb_exclude=<不参与的顶层目录，逗号分隔>

退出码：0 成功；1 用法或配置错误；3 检查未通过，未发布；4 已提交到本地，但推送失败。
"""
import html
import json
import os
import re
import subprocess
import sys
from datetime import date
from urllib.parse import quote

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import kbsite  # noqa: E402

CONFIG = os.environ.get("DISPATCH_CONFIG") or os.path.expanduser("~/.claude/dispatch/config")

BLOCK = [
    ("本机绝对路径", r"/(?:Users|home)/[A-Za-z0-9._-]+/"),
    ("邮箱", r"[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}"),
    ("疑似密钥", r"sk-[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}"
                r"|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----"),
    ("Artifact 专属能力（站点上无法运行）", r"claude\.use\("),
]
WARN = [
    ("私有 Artifact 链接（访客打不开）", r"claude\.ai/(?:code/)?artifact/[A-Za-z0-9-]+"),
    # 只提醒不拦截：个人项目文档里多半是 your-password 这类占位或本地默认值，真假由人判断
    # DB_PASSWORD=、JWT_SECRET= 这类带前缀的写法也要认出来，所以不能用 \b 卡开头
    ("疑似口令赋值", r"(?i)[a-z_]{0,20}(?:password|passwd|secret|api[_-]?key|access[_-]?token)"
                r"[\"']?\s*[:=]\s*[\"']?[^\s\"'<>,;]{4,}"),
]
EMAIL_OK = re.compile(r"^(git|noreply|no-reply)@|@(example\.(com|org)|users\.noreply\.github\.com)$", re.I)


def fail(msg, code=1):
    sys.stdout.flush()
    print(msg, file=sys.stderr)
    sys.exit(code)


def load_config():
    cfg = {}
    if os.path.exists(CONFIG):
        with open(CONFIG, encoding="utf-8") as f:
            for line in f:
                m = re.match(r"\s*([a-z_]+)\s*=\s*(.*?)\s*$", line)
                if m and not line.lstrip().startswith("#"):
                    cfg[m.group(1)] = m.group(2)
    return cfg


CFG = load_config()


def repo_dir():
    d = CFG.get("pages_repo")
    if not d:
        fail("未配置文档站：在 ~/.claude/dispatch/config 写入 pages_repo=<站点仓库目录> 和 pages_url=<网址>。")
    d = os.path.expanduser(d).rstrip("/")
    if not os.path.isdir(os.path.join(d, ".git")):
        fail(f"站点仓库不存在或不是 git 仓库：{d}")
    return d


def site_url():
    return CFG.get("pages_url", "").rstrip("/")


def take_opt(args, flag, default=None):
    if flag in args:
        i = args.index(flag)
        if i + 1 >= len(args):
            fail(f"{flag} 后面缺少值")
        value = args[i + 1]
        del args[i:i + 2]
        return value
    return default


def take_flag(args, flag):
    if flag in args:
        args.remove(flag)
        return True
    return False


def split_list(s):
    return [x.strip() for x in (s or "").split(",") if x.strip()]


# ---------- 检查 ----------

def scan(text, allow):
    allow = {a.lower() for a in allow}
    rules = [(name, re.compile(p)) for name, p in BLOCK]
    for term in split_list(CFG.get("pages_deny")):
        if re.fullmatch(r"[A-Za-z0-9_.-]+", term):
            p = r"(?<![A-Za-z0-9])" + re.escape(term) + r"(?![A-Za-z0-9])"
        else:
            p = re.escape(term)
        rules.append((f"敏感词「{term}」", re.compile(p, re.I)))
    blocks, warns = [], []
    lines = text.splitlines()
    for no, line in enumerate(lines, 1):
        for kind, target, pats in (("block", blocks, rules), ("warn", warns, [(n, re.compile(p)) for n, p in WARN])):
            for name, rx in pats:
                for m in rx.finditer(line):
                    hit = m.group(0)
                    if hit.lower() in allow or (name == "邮箱" and EMAIL_OK.search(hit)):
                        continue
                    s = max(0, m.start() - 20)
                    ctx = re.sub(r"\s+", " ", line[s:m.end() + 20]).strip()
                    target.append(f"{no:>5} │ {name} │ {hit} │ …{ctx}…")
    return blocks, warns


def report(blocks, warns):
    for title, items in (("未通过", blocks), ("提醒", warns)):
        if items:
            print(f"── {title}（{len(items)} 处，最多列 20 处）──")
            for x in items[:20]:
                print(x[:220])


# ---------- 页面 ----------

HEAD_TAG = re.compile(r"\s*(<title>.*?</title>|<meta\b[^>]*>|<link\b[^>]*>)", re.S | re.I)

BASE_STYLE = (":root{color-scheme:light;padding-top:env(safe-area-inset-top,0px);"
              "padding-bottom:env(safe-area-inset-bottom,0px)}"
              "body{margin:0;font:14px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;background:#fafaf9}"
              "img{max-width:100%}[hidden]{display:none!important}")


INDEX_LINK = re.compile(r'<link rel="index" href="[^"]*">')
BAD_CHARS = re.compile(r'[\\/:*?"<>|\x00-\x1f]')


def safe_name(s):
    s = re.sub(r"\s+", " ", BAD_CHARS.sub("-", s)).strip().strip(".")
    return s[:80] or "未命名"


def docs_root():
    return CFG.get("pages_docs_dir", "文档").strip("/") or "文档"


def folder_of(entry):
    return safe_name(entry["project"]) if entry.get("project") else CFG.get("pages_misc", "其他")


def target_path(entry, others):
    """文档/<项目>/<标题>.html；同目录下已有同名的其他文档时，在文件名后加 slug 区分。"""
    base = f"{docs_root()}/{folder_of(entry)}/{safe_name(entry['title'])}"
    rel = base + ".html"
    if any(p.get("path") == rel for p in others):
        rel = f"{base}（{entry['slug']}）.html"
    return rel


def index_href(rel):
    return "../" * rel.count("/") + "index.html"


def legacy_path(slug):
    return f"p/{slug}/index.html"


def page_url(slug):
    """线上网址用英文 slug，和仓库里的中文存放路径无关。"""
    return f"{site_url()}/p/{slug}/" if site_url() else f"p/{slug}/"


def prune_empty(repo, rel_file):
    d = os.path.dirname(os.path.join(repo, rel_file))
    while os.path.abspath(d) != os.path.abspath(repo) and os.path.isdir(d) and not os.listdir(d):
        os.rmdir(d)
        d = os.path.dirname(d)


def place(repo, entry, others):
    """把文档移到它该在的位置（标题、项目变了，或从旧的 p/<slug>/ 结构迁移），返回新路径。"""
    rel = target_path(entry, others)
    cur = entry.get("path") or legacy_path(entry["slug"])
    src, dst = os.path.join(repo, cur), os.path.join(repo, rel)
    if cur != rel and os.path.exists(src):
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        with open(src, encoding="utf-8") as f:
            text = f.read()
        with open(dst, "w", encoding="utf-8") as f:
            f.write(INDEX_LINK.sub(f'<link rel="index" href="{index_href(rel)}">', text, count=1))
        os.remove(src)
        prune_empty(repo, cur)
    entry["path"] = rel
    return rel


def wrap(src, desc, rel):
    """Artifact 页面只有正文片段（外壳由平台补），这里补成完整文档。已经是完整文档的原样返回。"""
    if re.match(r"\s*(<!doctype|<html)", src, re.I):
        return INDEX_LINK.sub(f'<link rel="index" href="{index_href(rel)}">', src, count=1)
    head, rest = [], src
    while True:
        m = HEAD_TAG.match(rest)
        if not m:
            break
        head.append(m.group(1))
        rest = rest[m.end():]
    meta = f'<meta name="description" content="{html.escape(desc)}">\n' if desc else ""
    return (
        "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n"
        "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n"
        f"{meta}<link rel=\"index\" href=\"{index_href(rel)}\">\n" + "\n".join(head) +
        f"\n<style>{BASE_STYLE}</style>\n</head>\n<body>\n{rest.strip()}\n</body>\n</html>\n"
    )


def page_title(src, fallback):
    m = re.search(r"<title>(.*?)</title>", src, re.S | re.I)
    return html.unescape(m.group(1)).strip() if m else fallback


def page_desc(src):
    m = re.search(r'<meta\s+name="description"\s+content="([^"]*)"', src, re.I)
    return html.unescape(m.group(1)).strip() if m else ""


# ---------- 目录 ----------

def load_catalog(repo):
    p = os.path.join(repo, "catalog.json")
    if os.path.exists(p):
        with open(p, encoding="utf-8") as f:
            return json.load(f)
    return {"pages": []}


def save_catalog(repo, cat):
    cat["pages"].sort(key=lambda x: (x.get("updated", ""), x["slug"]), reverse=True)
    with open(os.path.join(repo, "catalog.json"), "w", encoding="utf-8") as f:
        json.dump(cat, f, ensure_ascii=False, indent=2)
        f.write("\n")


INDEX_CSS = kbsite.TOKENS + """
main{max-width:820px;margin:0 auto}
header.site{padding-block:56px 24px;border-bottom:1px solid var(--rule)}
h1{font:900 clamp(30px,5vw,42px)/1.2 var(--serif);margin:12px 0 10px;text-wrap:balance}
.lede{color:var(--muted);margin:0 0 6px}
.ramp{display:flex;gap:3px;margin-top:20px;height:6px;max-width:260px}
.ramp i{flex:1;border-radius:1px}
.controls{display:grid;gap:12px;padding-block:22px 6px}
#q{width:100%;font:15px var(--sans);padding:10px 12px;border:1px solid var(--rule);border-radius:6px;background:var(--paper);color:var(--ink)}
#q:focus-visible,button:focus-visible,.item a:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.row{display:flex;flex-wrap:wrap;gap:6px;align-items:center}

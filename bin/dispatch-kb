#!/usr/bin/env python3
"""dispatch-kb：用尽量少的输出检索个人知识库（按目录组织的 Markdown 笔记）。

每篇笔记只回一行（路径 │ 类型 │ 日期 │ 摘要），先靠这一行判断要不要打开；
要打开时先看 outline，再只读需要的小节。整篇笔记不进上下文。

用法：
  dispatch-kb path                          打印知识库目录
  dispatch-kb dirs                          列出顶层目录和各自的笔记数
  dispatch-kb search <词>... [-d 子目录] [-n 条数] [--all]
                                            按关键词找笔记。同一概念的几种说法用 | 连成一个词（报错|故障）；
                                            只列命中词数最多、分数接近第一名的结果；
                                            同一篇的多个版本（简版、修订版、终版……）只显示最新的，--all 看全部
  dispatch-kb list [子目录] [-n 条数]         列出笔记
  dispatch-kb outline <笔记路径>              打印摘要和标题大纲（带行号）

配置：环境变量 DISPATCH_KB_DIR，或 ~/.claude/dispatch/config 里的
  kb_dir=<知识库目录>
  kb_exclude=<不参与检索的顶层目录，逗号分隔>
"""
import os
import re
import sys
from datetime import date

CONFIG = os.path.expanduser("~/.claude/dispatch/config")
SUMMARY_WIDTH = 70


def load_config():
    cfg = {}
    if os.path.exists(CONFIG):
        with open(CONFIG, encoding="utf-8") as f:
            for line in f:
                m = re.match(r"\s*([a-z_]+)\s*=\s*(.*?)\s*$", line)
                if m and not line.lstrip().startswith("#"):
                    cfg[m.group(1)] = m.group(2)
    if os.environ.get("DISPATCH_KB_DIR"):
        cfg["kb_dir"] = os.environ["DISPATCH_KB_DIR"]
    return cfg


def fail(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


CFG = load_config()


def kb_dir():
    d = CFG.get("kb_dir")
    if not d:
        fail("未配置知识库：在 ~/.claude/dispatch/config 写入 kb_dir=<目录>，或设置环境变量 DISPATCH_KB_DIR。")
    d = os.path.expanduser(d)
    if not os.path.isdir(d):
        fail(f"知识库目录不存在：{d}")
    return d.rstrip("/")


def excluded():
    return {x.strip().strip("/") for x in CFG.get("kb_exclude", "").split(",") if x.strip()}


def notes(root, sub=None):
    base = os.path.join(root, sub) if sub else root
    if not os.path.isdir(base):
        fail(f"目录不存在：{base}")
    skip = excluded()
    for dirpath, dirnames, filenames in os.walk(base):
        rel_dir = os.path.relpath(dirpath, root)
        dirnames[:] = sorted(
            d for d in dirnames
            if not d.startswith(".") and not (rel_dir == "." and d in skip)
        )
        for name in sorted(filenames):
            if name.endswith(".md") and name != ".md":
                yield os.path.join(dirpath, name)


def parse(path):
    """返回 (元数据, 全文, 行列表)。没有 frontmatter 的笔记，用一级标题和第一段正文补 title / summary。"""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError:
        return None
    lines = text.splitlines()
    meta, start = {}, 0
    if lines and lines[0].strip() == "---":
        for i in range(1, min(len(lines), 80)):
            if lines[i].strip() == "---":
                start = i + 1
                break
            m = re.match(r"([A-Za-z_]+)\s*:\s*(.*)", lines[i])
            if m:
                meta[m.group(1).lower()] = m.group(2).strip().strip("\"'")
    in_code = False
    for line in lines[start:start + 60]:
        s = line.strip()
        if s.startswith("```"):
            in_code = not in_code
            continue
        if in_code or not s or s.startswith(("|", "---", "<")):
            continue
        if s.startswith("# ") and "title" not in meta:
            meta["title"] = s[2:].strip()
            continue
        if s.startswith("#"):
            continue
        if "summary" not in meta:
            meta["summary"] = re.sub(r"^([>*\-+]\s*|\d+\.\s+)+", "", s).replace("**", "")
        if "title" in meta and "summary" in meta:
            break
    return meta, text, lines


def when(path, meta):
    d = meta.get("updated") or meta.get("created")
    if d:
        return d[:10]
    return date.fromtimestamp(os.path.getmtime(path)).isoformat()


def row(root, path, meta):
    summary = meta.get("summary", "")
    if len(summary) > SUMMARY_WIDTH:
        summary = summary[:SUMMARY_WIDTH] + "…"
    rel = os.path.relpath(path, root)
    return f"{rel} │ {meta.get('type', '-')} │ {when(path, meta)} │ {summary}"


def take_opt(args, flag, default):
    if flag in args:
        i = args.index(flag)
        if i + 1 >= len(args):
            fail(f"{flag} 后面缺少值")
        value = args[i + 1]
        del args[i:i + 2]
        return value
    return default


def cmd_dirs(root):
    skip = excluded()
    counts = {}
    for p in notes(root):
        top = os.path.relpath(p, root).split(os.sep)[0]
        top = top if os.path.isdir(os.path.join(root, top)) else "（根目录）"
        counts[top] = counts.get(top, 0) + 1
    for name, n in sorted(counts.items()):
        print(f"{name}/ │ {n} 篇" if name != "（根目录）" else f"{name} │ {n} 篇")
    if skip:
        print(f"（已排除：{', '.join(sorted(skip))}）")


# 同一篇笔记的多个版本（简版、修订版、v2、终版……）：检索时只显示最"新"的一篇
VERSION_TAG = re.compile(r"[\s\-_（(]*(终版|最终版|定稿|修订版|简版|初稿|草稿|副本|final|draft|copy|(?<![A-Za-z])v\d+)[\s)）]*$", re.I)


def version_key(path):
    """返回 (同目录, 去掉版本标记的文件名, 版本优先级)。终版 > vN > 修订版 > 无标记 > 简版/初稿。"""
    name = os.path.splitext(os.path.basename(path))[0]
    rank, first = 3, True
    while True:
        m = VERSION_TAG.search(name)
        if not m:
            break
        tag = m.group(1).lower()
        if first:
            if tag in ("终版", "最终版", "定稿", "final"):
                rank = 100
            elif re.fullmatch(r"v\d+", tag):
                rank = 10 + int(tag[1:])
            elif tag == "修订版":
                rank = 5
            elif tag in ("简版", "初稿", "草稿", "draft"):
                rank = 1
            else:
                rank = 2
            first = False
        name = name[:m.start()]
    return os.path.dirname(path), name.strip(" -_"), rank


def fold_versions(items):
    """items：[(分数, 路径, meta)]，已按分数从高到低排好。同一篇的多个版本合成一条：
    位置取组内最高分，显示版本优先级最高的那篇，并返回其余版本数。"""
    groups, order = {}, []
    for score, path, meta in items:
        d, stem, rank = version_key(path)
        key = (d, stem) if stem else (path,)
        if key not in groups:
            groups[key] = []
            order.append(key)
        groups[key].append((rank, os.path.getmtime(path), score, path, meta))
    out = []
    for key in order:
        g = groups[key]
        best = max(g, key=lambda x: (x[0], x[1]))
        out.append((best[3], best[4], len(g) - 1))
    return out


def fmt_rows(root, folded):
    return [row(root, p, meta) + (f"（另有 {n} 个版本，加 --all 查看）" if n else "") for p, meta, n in folded]


def cmd_list(root, args):
    limit = int(take_opt(args, "-n", "20"))
    show_all = "--all" in args
    args = [a for a in args if a != "--all"]
    sub = args[0] if args else None
    found = [(p, parse(p)) for p in notes(root, sub)]
    items = [(0, p, r[0]) for p, r in found if r]
    folded = [(p, m, 0) for _, p, m in items] if show_all else fold_versions(items)
    for line in fmt_rows(root, folded[:limit]):
        print(line)
    if len(folded) > limit:
        print(f"……共 {len(folded)} 篇，只列出前 {limit} 篇（用 -n 调整）")


def term_variants(t):
    """「报错|故障|异常」表示同一个概念的几种说法，命中任意一种都算命中这个词。"""
    return [v for v in t.lower().split("|") if v]


def cmd_search(root, args):
    sub = take_opt(args, "-d", None)
    limit = int(take_opt(args, "-n", "10"))
    show_all = "--all" in args
    terms = [term_variants(t) for t in args if t.strip() and t != "--all"]
    terms = [t for t in terms if t]
    if not terms:
        fail("用法：dispatch-kb search <词>... [-d 子目录] [-n 条数] [--all]（同义词用 | 连接，如 报错|故障）")
    hits = []
    for p in notes(root, sub):
        parsed = parse(p)
        if not parsed:
            continue
        meta, text, _ = parsed
        rel = os.path.relpath(p, root)
        head = " ".join([rel, meta.get("title", ""), meta.get("summary", ""), meta.get("tags", ""), meta.get("type", "")]).lower()
        body = text.lower()
        # 长笔记按篇幅打折，避免只因为篇幅长、出现次数多就排到前面
        norm = min(1.0, (3000 / max(len(body), 1)) ** 0.5)
        matched, score = 0, 0.0
        for variants in terms:
            n = max(body.count(v) for v in variants)
            in_head = any(v in head for v in variants)
            if in_head or n:
                matched += 1
                score += (10 if in_head else 0) + min(n, 5) * norm
        if matched:
            hits.append((matched, score, rel, p, meta))
    if not hits:
        print("没有找到相关笔记。")
        return
    # 截尾：只留命中词数最多的那一档，且分数不低于第一名的 1/4
    top_matched = max(h[0] for h in hits)
    hits = [h for h in hits if h[0] == top_matched]
    hits.sort(key=lambda h: (-h[1], h[2]))
    top_score = hits[0][1]
    hits = [h for h in hits if h[1] >= top_score / 4]
    items = [(s, p, meta) for _, s, _, p, meta in hits]
    folded = [(p, m, 0) for _, p, m in items] if show_all else fold_versions(items)
    note = f"命中全部 {len(terms)} 个词" if top_matched == len(terms) else f"最多命中 {top_matched}/{len(terms)} 个词"
    print(f"找到 {len(folded)} 篇，{note}" + (f"，显示前 {limit} 篇" if len(folded) > limit else "") + "（路径 │ 类型 │ 日期 │ 摘要）：")
    for line in fmt_rows(root, folded[:limit]):
        print(line)


def cmd_outline(root, args):
    if not args:
        fail("用法：dispatch-kb outline <笔记路径>")
    path = args[0] if os.path.isabs(args[0]) else os.path.join(root, args[0])
    parsed = parse(path)
    if not parsed:
        fail(f"读不到笔记：{path}")
    meta, _, lines = parsed
    print(f"{row(root, path, meta)} │ 共 {len(lines)} 行")
    if meta.get("tags"):
        print(f"tags: {meta['tags']}")
    in_code = False
    for i, line in enumerate(lines, 1):
        if line.strip().startswith("```"):
            in_code = not in_code
            continue
        m = re.match(r"(#{1,3})\s+(.*)", line)
        if m and not in_code:
            print(f"{i:>5}  {'  ' * (len(m.group(1)) - 1)}{m.group(2).strip()}")


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cmd, rest = args[0], args[1:]
    root = kb_dir()
    if cmd == "path":
        print(root)
    elif cmd == "dirs":
        cmd_dirs(root)
    elif cmd == "list":
        cmd_list(root, rest)
    elif cmd == "search":
        cmd_search(root, rest)
    elif cmd == "outline":
        cmd_outline(root, rest)
    else:
        fail(f"未知子命令：{cmd}（可用：path、dirs、search、list、outline）")


if __name__ == "__main__":
    main()
